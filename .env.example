# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 git에 올라가지 않음)
ANTHROPIC_API_KEY=

# 텔레그램 봇 — 채널마다 별도 봇 (프레피팝: 사장님, 히썹 아카데미: 사모님)
PREPPY_POP_BOT_TOKEN=
HSSUP_ACADEMY_BOT_TOKEN=

# Meta for Developers 앱 (Instagram Graph API 직접 연동, 앱은 공용·계정만 다름)
FB_APP_ID=
FB_APP_SECRET=
PREPPY_POP_IG_BUSINESS_ID=
PREPPY_POP_IG_TOKEN=
HSSUP_IG_BUSINESS_ID=
HSSUP_IG_TOKEN=

# 카드뉴스/사진을 올릴 public 이미지 저장소 (owner/repo 형식)
ASSETS_REPO=
ASSETS_REPO_TOKEN=
